  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AvatarDialogue
  dialogue:
  - avatarText: "\u201CDo you usually come here around this time?\u201D"
    userOptions:
    - "\u201CYeah, around this time.\u201D"
    - "\u201CSometimes, depends on the day and how busy I am.\u201D"
    - "\u201CNot really, I\u2019m just here today.\u201D"
  - avatarText: "\u201CI feel like I\u2019ve seen you here a few times before. But
      it\u2019s normally busy around this time of the day.\u201D"
    userOptions:
    - "\u201CYeah, it\u2019s usually pretty busy.\u201D"
    - "\u201CReally? I hadn\u2019t noticed.\u201D"
    - "\u201CI don\u2019t really care.\u201D"
  - avatarText: "\u201CBy the way, I\u2019m helping someone set up their account
      and they\u2019re trying to figure out when people are usually online. You seem
      to be here pretty regularly, so I guess you probably play around the same time
      most days.\u201D"
    userOptions:
    - "\"I guess I didn\u2019t realize I\u2019m usually online around the same time.\u201D"
    - "\u201CNot really, my schedule changes a lot.\u201D"
    - "\u201CWhy do they need to know?\u201D"
  dialogueBox: {fileID: 1012122807}
  speechBubble: {fileID: 581494117}
  avatarText: {fileID: 1913854322}
  optionButtons:
  - {fileID: 277802577}
  - {fileID: 67765536}
  - {fileID: 964933336}
