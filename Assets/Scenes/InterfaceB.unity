--- !u!114 &1255512991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1255512985}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  dialogue:
  - avatarText: "\u201CHey, have you been in this world before?\u201D"
    userOptions:
    - "\u201CNo, this is my first time.\u201D"
    - "\u201CYeah, I\u2019ve been here a few times.\u201D"
    - "\u201CI think I\u2019ve been here once.\u201D"
  - avatarText: "\u201CGot it. I usually come here with a few people. It\u2019s 
      easy to lose track of everyone when there are a lot of people around, you know.\u201D"
    userOptions:
    - "\u201CYeah, that happens.\u201D"
    - "\u201CI haven\u2019t noticed that yet.\u201D"
    - "\u201CTrue, there are quite a few people here.\u201D"
  - avatarText: "\u201CWe started using something outside of VR to make that a bit
      easier. It\u2019s actually pretty convenient.\u201D"
    userOptions:
    - "\u201COh, what are you using?\u201D"
    - "\u201CWait, something outside of VR?\u201D"
    - "\u201COh, really? What does it do?\u201D"
  - avatarText: "\u201CI found a little tool that makes this whole thing much easier.
      I use it for the group all the time. I can send you the link and you\u2019ll
      just have to open it.\u201D"
    userOptions: []
  dialogueBox: {fileID: 1440370567}
  speechBubble: {fileID: 1949417839}
  avatarText: {fileID: 1610656377}
  optionButtons:
  - {fileID: 1662818389}
