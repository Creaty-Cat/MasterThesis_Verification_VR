--- !u!114 &834067651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 834067644}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AvatarDialogue
  dialogue:
  - avatarText: "\u201CDid you happen to go to the meetup recently?\u201D"
    userOptions:
    - "\u201CWhat meetup?\u201D"
    - "\u201CNo, I couldn\u2019t make it.\u201D"
    - "\u201CYeah, I was there. Why?\u201D"
  - avatarText: "\u201CI saw some pictures from it afterwards. It was actually kind
      of trying to figure out who everyone was from their avatars.\u201D"
    userOptions:
    - "\u201CWere you able to recognize anyone?\u201D"
    - "\u201CWait, how did you know who was who?\u201D"
    - '"Ok?"'
  - avatarText: "\u201CI think I actually recognized one of the avatars. It might
      have been yours, but I\u2019m not completely sure.\u201D"
    userOptions:
    - "\u201COh really? Which one?\u201D"
    - "\u201CHaha, what makes you think that?\u201D"
    - "\u201CWhy do you want to know?\u201D"
  - avatarText: "\u201CI think I found a profile that might be yours outside of VR
      too. You usually use the same username on social media, right? Or do you use
      a different name?\u201D"
    userOptions: []
  dialogueBox: {fileID: 1736957209}
  speechBubble: {fileID: 1790420405}
  avatarText: {fileID: 1716950661}
  optionButtons:
  - {fileID: 913159907}
  - {fileID: 1635529881}
  - {fileID: 1198614480}
