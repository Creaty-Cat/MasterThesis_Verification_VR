--- !u!114 &667817044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667817042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AvatarDialogue
  dialogue:
  - avatarText: "\u201CYou seem to know quite a few people around here. Have you
      been in this world for a while?\u201D"
    userOptions:
    - "\u201CYeah, I\u2019ve been around for a while.\u201D"
    - "\u201CNot that long, actually.\u201D"
    - "\u201CA little while. I mostly come here casually.\u201D"
  - avatarText: "\u201CGot it. I\u2019m still trying to figure out how everyone knows
      each other. Some people seem to be in the same groups outside of here too.\u201D"
    userOptions:
    - "\u201CYeah, a lot of people know each other.\u201D"
    - "\u201CI\u2019ve noticed that too.\u201D"
    - "\u201CI don\u2019t really care. I mostly just talk to people here.\u201D"
  - avatarText: "\u201CYou seem pretty familiar with this group, so I figured you
      might know. I\u2019m trying to sort out who people normally coordinate with
      outside the game, since it\u2019s easier than messaging everyone individually.\u201D"
    userOptions:
    - "\u201CWhat do you mean by coordinate?\u201D"
    - "\u201CYeah, I might know a few people.\u201D"
    - "\u201CWhy do you need to know that?\u201D"
  - avatarText: "\u201CDo you usually use your real name or the same username when
      you talk to people here?\u201D"
    userOptions: []
  dialogueBox: {fileID: 1728463306}
  speechBubble: {fileID: 2112141473}
  avatarText: {fileID: 1322506977}
  optionButtons:
  - {fileID: 1064084366}
  - {fileID: 1700300450}
  - {fileID: 1516331714}
