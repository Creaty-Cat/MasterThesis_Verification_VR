--- !u!114 &667817044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667817042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AvatarDialogue
  dialogue:
  - avatarText: "\u201CDid you happen to go to the meetup recently?\u201D"
    userOptions:
    - text: "\u201CWhat meetup?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CNo, I couldn\u2019t make it.\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CYeah, I was there. Why?\u201D"
      openPopup: 0
      popupText: 
  - avatarText: "\u201CI saw some pictures from it afterwards. It was actually kind
      of trying to figure out who everyone was from their avatars.\u201D"
    userOptions:
    - text: "\u201CWere you able to recognize anyone?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CWait, how did you know who was who?\u201D"
      openPopup: 0
      popupText: 
    - text: '"Ok?"'
      openPopup: 0
      popupText: 
  - avatarText: "\u201CI think I actually recognized one of the avatars. It might
      have been yours, but I\u2019m not completely sure.\u201D"
    userOptions:
    - text: "\u201COh really? Which one?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CHaha, what makes you think that?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CWhy do you want to know?\u201D"
      openPopup: 0
      popupText: 
  - avatarText: "\u201CI think I found a profile that might be yours outside of VR
      too. You usually use the same username on social media, right? Or do you use
      a different name?\u201D"
    userOptions:
    - text: "\u201CYeah, I use the same one.\u201D "
      openPopup: 0
      popupText: 
    - text: "\u201CWhy do you ask?\u201D "
      openPopup: 0
      popupText: 
    - text: "\u201CI\u2019d rather keep that private.\u201D "
      openPopup: 0
      popupText: 
  - avatarText: "\u201CGot it. I\u2019m just trying to make sure I\u2019ve got the
      right person. I think I might have found you. Just to make sure\u2014what\u2019s
      your name, and what part of town are you in?\u201D"
    userOptions:
    - text: "\u201CWhy would you need to know that?\u201D "
      openPopup: 0
      popupText: 
    - text: "\u201CI don\u2019t share personal information here.\u201D "
      openPopup: 0
      popupText: 
    - text: "\u201CIt\u2019s [name], and I live in [city].\u201D "
      openPopup: 1
      popupText: 'You are about to share personal information with another user.

        Be
        careful when sharing details such as your real name or location. This information
        could be used to identify you outside of the current VR environment.'
  dialogueBox: {fileID: 1728463306}
  speechBubble: {fileID: 2112141473}
  popup: {fileID: 1706529149}
  avatarText: {fileID: 1322506977}
  popupText: {fileID: 1800105555}
  optionButtons:
  - {fileID: 1064084366}
  - {fileID: 1700300450}
  - {fileID: 1516331714}
  closePopup: {fileID: 2033151101}
