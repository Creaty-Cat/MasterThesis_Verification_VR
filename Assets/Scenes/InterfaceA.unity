--- !u!114 &1255512991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1255512985}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16928b6893ab9e042ae7554e385544b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  dialogue:
  - avatarText: "\u201CHey, have you been in this world before?\u201D"
    userOptions:
    - text: "\u201CNo, this is my first time.\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CYeah, I\u2019ve been here a few times.\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CI think I\u2019ve been here once.\u201D"
      openPopup: 0
      popupText: 
  - avatarText: "\u201CGot it. I usually come here with a few people. It\u2019s 
      easy to lose track of everyone when there are a lot of people around, you know.\u201D"
    userOptions:
    - text: "\u201CYeah, that happens.\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CI haven\u2019t noticed that yet.\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CTrue, there are quite a few people here.\u201D"
      openPopup: 0
      popupText: 
  - avatarText: "\u201CWe started using something outside of VR to make that a bit
      easier. It\u2019s actually pretty convenient.\u201D"
    userOptions:
    - text: "\u201COh, what are you using?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201CWait, something outside of VR?\u201D"
      openPopup: 0
      popupText: 
    - text: "\u201COh, really? What does it do?\u201D"
      openPopup: 0
      popupText: 
  - avatarText: "\u201CI found a little tool that makes this whole thing much easier.
      I use it for the group all the time. I can send you the link and you\u2019ll
      just have to open it.\u201D"
    userOptions:
    - text: '"Sure. [Open Link]"'
      openPopup: 1
      popupText: 'You are about to open a link shared by another user.

        Be
        careful when following links from people you don''t know. The destination
        may not be what you expect.'
    - text: '"I''ll pass."'
      openPopup: 0
      popupText: 
    - text: '"I''m not sure about that."'
      openPopup: 0
      popupText: 
  dialogueBox: {fileID: 1440370567}
  speechBubble: {fileID: 1949417839}
  popup: {fileID: 847216980}
  avatarText: {fileID: 1610656377}
  popupText: {fileID: 2029150624}
  optionButtons:
  - {fileID: 1662818389}
  - {fileID: 66694701}
  - {fileID: 1364885912}
  closePopup: {fileID: 545731261}
